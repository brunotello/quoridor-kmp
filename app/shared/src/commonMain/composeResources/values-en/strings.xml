    <!-- Rules -->
    <string name="rules_title">Game rules</string>
    <string name="rules_objective_title">Objective</string>
    <string name="rules_objective_body">Be the first to move your pawn to the row on the opposite side of the board.</string>
    <string name="rules_movement_title">Movement</string>
    <string name="rules_movement_body">On your turn you move your pawn one square horizontally or vertically. Diagonal moves are not allowed, except when jumping over an adjacent pawn.</string>
    <string name="rules_jumps_title">Jumps</string>
    <string name="rules_jumps_body">If an opponent pawn is on an adjacent square, you can jump over it and land on the next square. If a wall or the edge is behind the opponent, you may move diagonally.</string>
    <string name="rules_walls_title">Walls</string>
    <string name="rules_walls_body">Instead of moving, you can place one of your walls to block the way. Each wall spans two squares and can never leave a player without any path to their goal.</string>
    <string name="rules_walls_count_title">Available walls</string>
    <string name="rules_walls_count_body">In a 2-player game each player has 10 walls; in a 4-player game, 5 walls each.</string>
    <string name="rules_winning_title">How to win</string>
    <string name="rules_winning_body">You win by reaching any square on the row (or column) opposite your starting position.</string>

